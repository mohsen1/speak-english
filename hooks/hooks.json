{
  "description": "speak-english - rewrites finished assistant messages into plain English at display time",
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/rewrite-display.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
